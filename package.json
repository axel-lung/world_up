{
  "name": "worldup",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node esbuild.config.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/entrypoints/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env src/entrypoints/worker.ts",
    "import-catalog": "tsx --env-file-if-exists=.env src/entrypoints/import-catalog.ts"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.26",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-social-login": "^8.7.13",
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "^1.7.26",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pmtiles": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "supercluster": "^9.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
