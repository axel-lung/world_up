/map/*
!/map/README.md

# Android app (android/.gitignore has Gradle's output and what `npx cap sync`
# writes): signing keys and Firebase's configuration never enter the repository
/android/app/google-services.json
# Android Studio's settings for the project
/android/.idea/
*.jks
*.keystore

