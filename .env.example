# Copy to .env. The values below suit local development (docker-compose.dev.yml);
# the production .env exists only on the server and is never committed.

# Domain Traefik serves the site on (production and staging only).
APP_DOMAIN=localhost
# Public address of the site, used in e-mail links, canonical URLs and the
# sitemap. Production: https://<APP_DOMAIN>
APP_URL=http://localhost:3000
# Staging only: 1 keeps search engines out (robots.txt and noindex).
NOINDEX=

# The back-office account (/admin), which must set up an authenticator app.
# Production: the administrator's address.
ADMIN_EMAIL=admin@example.test
# Optional: User-Agent of the back-office's requests to Wikimedia Commons when
# replacing a photo. Defaults to "WorldUp/1.0 (<APP_URL>)".
WIKIMEDIA_USER_AGENT=

# Password of the worldup-db container (production and staging only).
POSTGRES_PASSWORD=
# Production: postgres://worldup:<POSTGRES_PASSWORD>@worldup-db:5432/worldup
DATABASE_URL=postgres://worldup:worldup@localhost:5432/worldup

# Session signing secret. Development value only: generate the production one
# with `openssl rand -base64 32`.
AUTH_SECRET=development-only-secret-never-use-in-production

# E-mails. Production and staging: Brevo's transactional API, with an API key
# (Brevo > SMTP & API > API keys). Without a key, the worker delivers over SMTP
# to Mailpit (docker-compose.dev.yml), whose inbox is at http://localhost:8025.
BREVO_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
# Sender, on a domain authenticated in Brevo (SPF, DKIM).
# Production: "World Up <no-reply@<domain>>"
MAIL_FROM="World Up <no-reply@localhost>"

# The publisher and the host, shown on /legal-notice and in the terms and the
# privacy policy (LCEN, art. 6). Required before the site opens to the public;
# an empty value shows as "à compléter".
# PUBLISHER_NAME: name of the sole trader, or company name with its legal form
# and capital ("World Up SAS, au capital de 1 000 €").
PUBLISHER_NAME=
PUBLISHER_ADDRESS=
# SIREN, or RCS number and city ("RCS Paris 123 456 789").
PUBLISHER_REGISTRATION=
# Optional: none under the VAT franchise.
PUBLISHER_VAT=
PUBLISHER_PHONE=
# Contact for players, data protection requests and reports of illegal content.
PUBLISHER_EMAIL=
PUBLICATION_DIRECTOR=
HOST_NAME=
HOST_ADDRESS=
HOST_PHONE=

# The Android app (android/), declared in /.well-known/assetlinks.json so that
# it opens the site without an address bar. Production only:
# ANDROID_APP_ID=fr.alng.worldup, and the SHA-256 fingerprints of the app
# signing key and of the upload key, separated by commas (Play Console > Test
# and release > App integrity).
ANDROID_APP_ID=
ANDROID_CERT_FINGERPRINTS=

# Stripe (payments lot).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Error tracking.
SENTRY_DSN=
