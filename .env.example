# Copy to .env. The values below suit local development (docker-compose.dev.yml);
# the production .env exists only on the server and is never committed.

# Domain Traefik serves the site on (production and staging only).
APP_DOMAIN=localhost
# Public address of the site, used in e-mail links. Production: https://<APP_DOMAIN>
APP_URL=http://localhost:3000

# Password of the worldup-db container (production and staging only).
POSTGRES_PASSWORD=
# Production: postgres://worldup:<POSTGRES_PASSWORD>@worldup-db:5432/worldup
DATABASE_URL=postgres://worldup:worldup@localhost:5432/worldup

# Session signing secret. Development value only: generate the production one
# with `openssl rand -base64 32`.
AUTH_SECRET=development-only-secret-never-use-in-production

# E-mails. Production and staging: Brevo's transactional API, with an API key
# (Brevo > SMTP & API > API keys). Without a key, the worker delivers over SMTP
# to Mailpit (docker-compose.dev.yml), whose inbox is at http://localhost:8025.
BREVO_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
# Sender, on a domain authenticated in Brevo (SPF, DKIM).
# Production: "Patrimoine de France <no-reply@<domain>>"
MAIL_FROM="Patrimoine de France <no-reply@localhost>"

# Stripe (payments lot).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Error tracking.
SENTRY_DSN=
